<% if @selectable_oshis.empty? %>
  <% registration_path = @activity.persisted? ? new_oshi_path : new_oshi_path(continue: ApplicationController::FIRST_ACTIVITY_CONTINUATION) %>
  <p><%= t("ui.activity.register_oshi_first") %><%= link_to t("ui.actions.register_oshi"), registration_path %></p>
<% end %>
<%= render "shared/validation_errors", resource: @activity %>
<% if @latest_activity %>
  <section class="conflict-summary" aria-labelledby="activity-conflict-heading">
    <h2 id="activity-conflict-heading"><%= t("ui.conflict.current") %></h2>
    <p><%= t("ui.conflict.compare_help") %></p>
    <dl>
      <dt><%= t("ui.labels.activity_date") %></dt><dd><%= @latest_activity.occurred_on %></dd>
      <dt><%= t("ui.labels.category") %></dt><dd><%= @latest_activity.activity_type %></dd>
      <dt><%= t("ui.labels.title") %></dt><dd><%= @latest_activity.title %></dd>
      <dt><%= t("ui.labels.place") %></dt><dd><%= @latest_activity.place.presence || "—" %></dd>
      <dt><%= t("ui.labels.amount") %></dt><dd><%= @latest_activity.amount.nil? ? "—" : "#{@latest_activity.amount}円" %></dd>
      <dt><%= t("ui.labels.oshi") %></dt><dd><%= @latest_activity.oshis.map(&:name).join("、") %></dd>
      <dt><%= t("ui.labels.emotions") %></dt><dd><%= @latest_activity.emotions.map(&:name).join("、").presence || "—" %></dd>
      <dt><%= t("ui.labels.memo") %></dt><dd><%= @latest_activity.memo.presence || "—" %></dd>
      <dt><%= t("ui.labels.images") %></dt><dd><%= @latest_activity.images.size %>件</dd>
    </dl>
    <p><%= link_to t("ui.actions.reload_edit"), edit_activity_path(@latest_activity), class: "button" %></p>
    <p><%= t("ui.conflict.image_help") %></p>
  </section>
<% end %>
<%= form_with model: @activity do |f| %>
  <% if @activity.persisted? %>
    <%= f.hidden_field :lock_version, value: @submitted_lock_version || @activity.lock_version %>
  <% end %>
  <div class="activity-form-grid">
    <fieldset class="form-field choice-field" aria-describedby="oshi-selection-help" aria-invalid="<%= @activity.errors[:activity_oshis].any? || @activity.errors[:base].any? %>">
      <legend><%= t("ui.activity.oshis_label") %></legend>
      <p id="oshi-selection-help"><%= t("ui.activity.selection_help") %></p>
      <div class="choice-chips">
        <%= f.collection_check_boxes :oshi_ids, @selectable_oshis, :id, :name, checked: @selected_oshi_ids do |choice| %>
          <%= choice.label(class: "choice-chip") { choice.check_box + tag.span(choice.text) } %>
        <% end %>
      </div>
    </fieldset>
    <div class="form-field">
      <%= f.label :occurred_on, t("ui.activity.occurred_on_label") %>
      <%= f.date_field :occurred_on, required: true, aria: { invalid: @activity.errors[:occurred_on].any? } %>
    </div>
    <div class="form-field">
      <%= f.label :activity_type, t("ui.activity.type_label") %>
      <%= f.select :activity_type, Activity::ACTIVITY_TYPES, { include_blank: t("ui.states.select_prompt") }, required: true, aria: { invalid: @activity.errors[:activity_type].any? } %>
    </div>
    <div class="form-field">
      <%= f.label :title, t("ui.activity.title_label") %>
      <%= f.text_field :title, placeholder: t("ui.placeholders.activity_title"), required: true, maxlength: 255, aria: { invalid: @activity.errors[:title].any? } %>
    </div>
    <div class="form-field">
      <%= f.label :place, t("ui.labels.place") %>
      <%= f.text_field :place, placeholder: t("ui.placeholders.place"), maxlength: 255, aria: { invalid: @activity.errors[:place].any? } %>
    </div>
    <div class="form-field">
      <%= f.label :amount, t("ui.activity.amount_label") %>
      <%= f.number_field :amount, min: 0, step: 1, aria: { invalid: @activity.errors[:amount].any?, describedby: "activity-amount-help" } %>
      <p id="activity-amount-help"><%= t("ui.activity.amount_help") %></p>
    </div>
  </div>
  <fieldset class="form-field choice-field" aria-describedby="emotion-selection-help" aria-invalid="<%= @activity.errors[:emotion_ids].any? %>">
    <legend><%= t("ui.activity.emotions_label") %></legend>
    <p id="emotion-selection-help"><%= t("ui.activity.emotion_help") %></p>
    <div class="choice-chips">
      <%= f.collection_check_boxes :emotion_ids, @selectable_emotions, :id, :name, checked: @selected_emotion_ids do |choice| %>
        <%= choice.label(class: "choice-chip") { choice.check_box + tag.span(choice.text) } %>
      <% end %>
    </div>
  </fieldset>
  <div class="form-field">
    <%= f.label :memo, t("ui.labels.memo") %>
    <%= f.text_area :memo, placeholder: t("ui.placeholders.memo"), rows: 5, aria: { invalid: @activity.errors[:memo].any? } %>
  </div>
  <% if @existing_images.any? %>
    <section>
      <h2><%= t("ui.activity.saved_images") %></h2>
      <div class="image-gallery">
        <% @existing_images.each_with_index do |image, index| %>
          <%= attachment_image_tag image, alt: t("ui.activity.image_alt", title: @activity.title, index: index + 1) %>
        <% end %>
      </div>
    </section>
  <% end %>
  <div class="form-field" data-controller="image-upload">
    <%= f.label :images, t("ui.activity.images_label") %>
    <%= f.file_field :images, multiple: true, accept: "image/jpeg,image/png,image/webp", data: { image_upload_target: "input", action: "change->image-upload#change" }, aria: { describedby: "activity-image-help activity-image-status", invalid: @activity.errors[:images].any? } %>
    <p id="activity-image-help"><%= t("ui.activity.image_help") %></p>
    <p id="activity-image-status" class="image-upload-status" data-image-upload-target="status" role="status" aria-live="polite"></p>
  </div>
  <%= f.submit(@activity.persisted? ? t("ui.actions.update") : t("ui.actions.record"), class: "button") %>
<% end %>
