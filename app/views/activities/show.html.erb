<% content_for :title, "活動記録の詳細 | OshiLog" %>
<h1>活動記録の詳細</h1>
<section class="card">
  <h2><%= @activity.title %></h2>
  <dl class="detail-rows">
    <dt>活動日</dt><dd><%= @activity.occurred_on.strftime("%Y/%m/%d") %></dd>
    <dt>カテゴリ</dt><dd><%= @activity.activity_type %></dd>
    <dt>推し</dt><dd><%= @activity.oshis.map(&:name).join("、") %></dd>
    <dt>感情タグ</dt><dd class="activity-emotions"><%= @activity.emotions.map(&:name).join("、").presence || "—" %></dd>
    <dt>場所</dt><dd><%= @activity.place.presence || "—" %></dd>
    <dt>金額</dt><dd><%= @activity.amount.nil? ? "—" : "#{number_with_delimiter(@activity.amount)}円" %></dd>
    <dt>メモ</dt><dd class="activity-memo"><%= @activity.memo.presence || "—" %></dd>
  </dl>
  <h2>画像</h2>
  <% if @existing_images.empty? %>
    <p>画像はありません。</p>
  <% else %>
    <div class="image-gallery">
      <% @existing_images.each_with_index do |image, index| %>
        <%= attachment_image_tag image, alt: "#{@activity.title}の画像 #{index + 1}" %>
      <% end %>
    </div>
  <% end %>
  <div class="actions">
    <%= link_to "編集", edit_activity_path(@activity, list_context: @list_context.presence) %>
    <%= button_to "削除", activity_path(@activity), method: :delete, class: "destructive-button", form: { data: { turbo_confirm: "この活動記録を削除しますか？" } } %>
  </div>
</section>
<p><%= link_to "活動記録一覧へ戻る", activities_path(@list_context) %></p>
