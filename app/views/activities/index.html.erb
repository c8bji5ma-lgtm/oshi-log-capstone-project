<% content_for :title, "活動記録一覧 | OshiLog" %>
<h1>活動記録一覧</h1>
<p><%= link_to "記録する", new_activity_path, class: "button" %></p>
<% if @filter_errors.any? %>
  <div class="validation-errors" role="alert"><%= @filter_errors.uniq.join(" ") %></div>
<% end %>
<%= form_with url: activities_path, method: :get, class: "activity-filter" do |f| %>
  <div class="form-field">
    <%= f.label :month, "年月" %>
    <%= f.month_field :month, value: @filters["month"] %>
  </div>
  <div class="form-field">
    <%= f.label :oshi_id, "推し" %>
    <%= f.select :oshi_id, options_from_collection_for_select(@selectable_oshis, :id, :name, @filters["oshi_id"]), include_blank: "すべて" %>
  </div>
  <div class="form-field">
    <%= f.label :activity_type, "カテゴリ" %>
    <%= f.select :activity_type, options_for_select(Activity::ACTIVITY_TYPES, @filters["activity_type"]), include_blank: "すべて" %>
  </div>
  <div class="form-field">
    <%= f.label :q, "キーワード" %>
    <%= f.search_field :q, value: @filters["q"] %>
  </div>
  <%= f.submit "絞り込む", class: "button" %>
  <%= link_to "条件をクリア", activities_path %>
<% end %>
<% if @activities.empty? %>
  <p>該当する活動記録はありません。</p>
<% else %>
  <% @activities.group_by { |activity| activity.occurred_on.strftime("%Y年%-m月") }.each do |month, activities| %>
    <section class="activity-month">
      <h2><%= month %></h2>
      <ul class="activity-list">
        <% activities.each do |activity| %>
          <li class="activity-entry">
            <time class="activity-entry-date" datetime="<%= activity.occurred_on.iso8601 %>"><span><%= activity.occurred_on.strftime("%-m/%-d") %></span></time>
            <div class="activity-entry-body">
              <p class="activity-entry-meta"><span><%= activity.activity_type %></span><span><%= activity.amount.nil? ? "—" : "#{number_with_delimiter(activity.amount)}円" %></span></p>
              <h3><%= link_to activity.title, activity_path(activity) %></h3>
              <% if activity.emotions.any? %>
                <p class="activity-emotions" aria-label="感情タグ"><%= activity.emotions.map(&:name).join("、") %></p>
              <% end %>
            </div>
          </li>
        <% end %>
      </ul>
    </section>
  <% end %>
<% end %>
