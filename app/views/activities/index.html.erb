<% content_for :title, "活動記録一覧 | OshiLog" %>
<h1>活動記録一覧</h1>
<p><%= link_to "記録する", new_activity_path, class: "button" %></p>
<% if @filters["year"].present? || @filters["month"].present? || @filters["oshi_id"].present? || @filters["activity_type"].present? || @filters["q"].present? %>
  <section class="card" aria-labelledby="activity-filter-summary">
    <h2 id="activity-filter-summary">適用中の条件</h2>
    <ul>
      <li>期間: <%= @filters["month"].presence || (@filters["year"].present? ? "#{@filters['year']}年" : "すべて") %></li>
      <% if @filters["oshi_id"].present? %><li>推し: <%= @selectable_oshis.find { |oshi| oshi.id.to_s == @filters["oshi_id"] }&.name || "確認できない推し" %></li><% end %>
      <% if @filters["activity_type"].present? %><li>カテゴリ: <%= @filters["activity_type"] %></li><% end %>
      <% if @filters["q"].present? %><li>キーワード: <%= @filters["q"] %></li><% end %>
    </ul>
    <p><%= link_to "条件を解除する", activities_path %> / <%= link_to "推し活データへ戻る", oshi_data_path(year: @filters["year"].presence || @filters["month"].to_s.first(4), oshi_id: @filters["oshi_id"].presence) %></p>
  </section>
<% end %>

<% if @filter_errors.any? %>
  <div id="activity-filter-errors" class="validation-errors" role="alert"><%= @filter_errors.uniq.join(" ") %></div>
<% end %>
<%= form_with url: activities_path, method: :get, class: "activity-filter" do |f| %>
  <div class="form-field">
    <%= f.label :month, "年月" %>
    <%= f.month_field :month, value: @filters["month"], aria: { describedby: ("activity-filter-errors" if @filter_errors.any?) } %>
    <%= f.hidden_field :year, value: @filters["year"] if @filters["year"].present? %>
    <%= f.hidden_field :through, value: @filters["through"] if @filters["through"].present? %>
  </div>
  <div class="form-field">
    <%= f.label :oshi_id, "推し" %>
    <%= f.select :oshi_id, options_from_collection_for_select(@selectable_oshis, :id, :name, @filters["oshi_id"]), { include_blank: "すべて" }, aria: { describedby: ("activity-filter-errors" if @filter_errors.any?) } %>
  </div>
  <div class="form-field">
    <%= f.label :activity_type, "カテゴリ" %>
    <%= f.select :activity_type, options_for_select(Activity::ACTIVITY_TYPES, @filters["activity_type"]), { include_blank: "すべて" }, aria: { describedby: ("activity-filter-errors" if @filter_errors.any?) } %>
  </div>
  <div class="form-field">
    <%= f.label :q, "キーワード" %>
    <%= f.search_field :q, value: @filters["q"], aria: { describedby: ("activity-filter-errors" if @filter_errors.any?) } %>
  </div>
  <%= f.submit "絞り込む", class: "button" %>
  <%= link_to "条件をクリア", activities_path %>
<% end %>
<% if @activities.empty? %>
  <p>該当する活動記録はありません。</p>
<% else %>
  <% @activities.group_by { |activity| activity.occurred_on.strftime("%Y年%-m月") }.each do |month, activities| %>
    <section class="activity-month">
      <h2><%= month %></h2>
      <ul class="activity-list">
        <% activities.each do |activity| %>
          <li class="activity-entry">
            <time class="activity-entry-date" datetime="<%= activity.occurred_on.iso8601 %>"><span><%= activity.occurred_on.strftime("%-m/%-d") %></span></time>
            <div class="activity-entry-body">
              <p class="activity-entry-meta"><span><%= activity.activity_type %></span><span><%= activity.amount.nil? ? "—" : "#{number_with_delimiter(activity.amount)}円" %></span></p>
              <h3><%= link_to activity.title, activity_path(activity) %></h3>
              <% if activity.emotions.any? %>
                <p class="activity-emotions" aria-label="感情タグ"><%= activity.emotions.map(&:name).join("、") %></p>
              <% end %>
            </div>
          </li>
        <% end %>
      </ul>
    </section>
  <% end %>
  <nav class="actions" aria-label="活動記録のページ移動">
    <% if @newer_cursor %>
      <%= link_to "新しい記録へ戻る", activities_path(@filters.merge(cursor: @newer_cursor, direction: "newer")), class: "button button-secondary" %>
    <% end %>
    <% if @older_cursor %>
      <%= link_to "さらに古い記録", activities_path(@filters.merge(cursor: @older_cursor, direction: "older")), class: "button button-secondary" %>
    <% end %>
  </nav>
<% end %>
