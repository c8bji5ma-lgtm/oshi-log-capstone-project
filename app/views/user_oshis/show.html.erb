<% content_for :title, "推し詳細 | OshiLog" %>
<h1>推し詳細</h1>
<section class="card">
  <h2>共通推し情報</h2>
  <dl class="detail-rows">
    <dt>推し名</dt><dd><%= @user_oshi.oshi.name %></dd>
    <dt>種別</dt><dd><%= @user_oshi.oshi.oshi_type %></dd>
    <dt>所属・作品</dt><dd><%= @user_oshi.oshi.affiliation.presence || "未設定" %></dd>
  </dl>
  <h2>あなたの推し情報</h2>
  <dl class="detail-rows">
    <dt>推し始め</dt><dd><%= @user_oshi.started_period.presence || "未設定" %></dd>
    <dt>推し終了時期</dt><dd><%= @user_oshi.ended_period.presence || "未設定" %></dd>
  </dl>
  <%= attachment_image_tag @representative_image, alt: "#{@user_oshi.oshi.name}の代表画像", class: "representative-image" %>
  <div class="actions">
    <%= link_to "この推しでカードを作る", new_card_path(user_oshi_id: @user_oshi.id), class: "button" %>
  </div>
</section>
<section class="card oshi-image-library" aria-labelledby="library-heading">
  <h2 id="library-heading">登録画像</h2>
  <%= render "user_oshis/image_gallery", manage: false %>
  <%= link_to "画像を管理・推し情報を編集", edit_user_oshi_path(@user_oshi), class: "button button-secondary" %>
</section>
<p><%= link_to "推し一覧へ戻る", oshis_path %></p>
