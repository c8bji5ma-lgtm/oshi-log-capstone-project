<div class="form-field" data-controller="image-upload">
  <%= f.label :library_images, label %>
  <%= f.file_field :library_images, multiple: true, accept: "image/jpeg,image/png,image/webp", data: { image_upload_target: "input", action: "change->image-upload#change" }, aria: { invalid: f.object.errors[:library_images].any?, describedby: "#{help_id} #{help_id}-status" } %>
  <p id="<%= help_id %>"><%= t("ui.oshi.upload_help") %></p>
  <p id="<%= help_id %>-status" class="image-upload-status" data-image-upload-target="status" role="status" aria-live="polite"></p>
</div>
