<% inline = local_assigns.fetch(:inline, false) %>
<% context_token = local_assigns[:context_token] %>
<div data-controller="oshi-registration"
     data-action="focusin@document->oshi-registration#trackFocus pointerdown@document->oshi-registration#trackPointer wheel@window->oshi-registration#trackScrollIntent touchstart@window->oshi-registration#trackScrollIntent pagehide@window->oshi-registration#leave turbo:before-visit@document->oshi-registration#leave turbo:before-cache@document->oshi-registration#leave visibilitychange@document->oshi-registration#visibilityChanged pageshow@window->oshi-registration#pageShown resize@window->oshi-registration#positionSuggestions"
     data-oshi-registration-suggest-labels-value="<%= t("ui.oshi.suggestions").to_json %>"
     data-oshi-registration-searching-value="<%= t("ui.oshi.searching") %>"
     data-oshi-registration-failed-value="<%= t("ui.oshi.search_failed") %>"
     data-oshi-registration-copied-value="<%= t("ui.oshi.search_copied") %>"
     data-oshi-registration-kept-value="<%= t("ui.oshi.search_kept") %>"
     data-oshi-registration-cleared-value="<%= t("ui.oshi.search_cleared") %>"
     data-oshi-registration-help-value="<%= t("ui.oshi.search_help") %>"
     data-oshi-registration-catalog-ready-value="<%= t("ui.oshi.catalog.ready") %>"
     data-oshi-registration-catalog-empty-value="<%= t("ui.oshi.catalog.empty") %>"
     data-oshi-registration-catalog-added-value="<%= t("ui.oshi.catalog.added") %>"
     data-oshi-registration-context-token-value="<%= context_token if inline %>">
<nav class="actions" aria-label="<%= t("ui.oshi.registration_navigation") %>">
  <%= link_to t("ui.oshi.existing_heading"), "#oshi-existing", class: "button", aria: { current: "step" }, data: { oshi_registration_target: "existingLink", action: "click->oshi-registration#returnToSearch" } %>
  <%= link_to t("ui.oshi.new_heading"), "#oshi-registration", class: "button button-secondary", data: { oshi_registration_target: "registrationLink", action: "click->oshi-registration#openRegistration" } %>
</nav>
<script type="application/json" data-oshi-registration-target="catalogSnapshot"><%= raw json_escape(render("oshis/catalog_cards", candidates: @catalog_oshis, selected_id: nil).to_json) %></script>
<section id="oshi-existing" class="card oshi-form" aria-labelledby="oshi-existing-heading" data-oshi-registration-target="existingPanel">
  <h2 id="oshi-existing-heading"><%= t("ui.oshi.existing_heading") %></h2>
  <p id="oshi-suggestion-help" hidden data-oshi-registration-target="suggestionHelp"><%= t("ui.oshi.suggestions.help") %></p>
  <%= form_with url: new_oshi_path, method: :get, class: "oshi-search-form", data: { oshi_registration_target: "searchForm", action: "submit->oshi-registration#ignoreImplicitSubmit" } do |f| %>
    <%= hidden_field_tag :activity_panel, "1" if inline %>
    <%= hidden_field_tag :continue, ApplicationController::FIRST_ACTIVITY_CONTINUATION if first_activity_continuation? %>
    <div class="form-field">
      <%= f.label :q, t("ui.labels.search_oshi") %>
      <%= f.search_field :q, value: params[:q], placeholder: t("ui.placeholders.oshi_search"), autocomplete: "off", data: { oshi_registration_target: "query", action: "input->oshi-registration#queryChanged compositionstart->oshi-registration#compositionStart compositionend->oshi-registration#compositionEnd keydown->oshi-registration#searchKeydown keyup->oshi-registration#compositionKeyup" } %>
    </div>
    <%= f.submit t("ui.actions.search"), class: "button", data: { oshi_registration_target: "searchButton", action: "click->oshi-registration#confirmSearch" } %>
    <ul id="oshi-suggestions" class="oshi-suggestions" role="listbox" aria-label="<%= t("ui.oshi.suggestions.heading") %>" hidden data-oshi-registration-target="suggestions"></ul>
  <% end %>
  <p id="oshi-search-status" role="status" aria-atomic="true" data-oshi-registration-target="status"></p>
  <%= render "shared/validation_errors", resource: @existing_user_oshi %>
  <%= form_with model: @existing_user_oshi, url: user_oshis_path, namespace: :existing, data: (inline ? { action: "submit->activity-oshi-panel#submitRegistration", turbo: false } : {}) do |f| %>
    <% if inline %>
      <%= hidden_field_tag :activity_panel, "1" %>
      <%= hidden_field_tag :activity_context_token, context_token, id: "existing_activity_context_token" %>
    <% end %>
    <%= hidden_field_tag :q, params[:q], id: "existing_query", data: { oshi_registration_target: "existingQuery" } %>
    <%= hidden_field_tag :continue, ApplicationController::FIRST_ACTIVITY_CONTINUATION, id: "existing_continue" if first_activity_continuation? %>
    <% search_query = params[:q].is_a?(String) ? params[:q] : "" %>
    <div id="oshi-search-results" data-oshi-registration-target="results"
         data-oshi-search-query="<%= search_query %>" data-oshi-search-count="<%= @oshis.size %>"
         data-oshi-search-state="<%= request.get? && search_query.present? ? (@oshis.any? ? "results" : "empty") : "initial" %>">
    <% if search_query.blank? %>
      <%= render "oshis/catalog_cards", candidates: @oshis, selected_id: @existing_user_oshi.oshi_id %>
    <% elsif @oshis.any? %>
      <% if @oshi_search_has_more %>
        <p role="status"><%= t("ui.oshi.search_limit") %></p>
      <% end %>
      <fieldset class="oshi-candidate-list">
        <legend><%= t("ui.oshi.existing_candidates") %></legend>
        <% @oshis.each do |oshi| %>
          <% status = oshi.approved? ? t("ui.states.approved") : t("ui.states.pending") %>
          <% common_image = @common_images[oshi.id] %>
          <div class="oshi-candidate">
            <%= radio_button_tag :oshi_id, oshi.id, @existing_user_oshi.oshi_id == oshi.id, id: "oshi_id_#{oshi.id}", required: true %>
            <%= label_tag "oshi_id_#{oshi.id}", class: "oshi-candidate-label" do %>
              <% if common_image %>
                <%= image_tag common_oshi_image_path(common_image.image.attachment), alt: "", class: "common-oshi-image", loading: "lazy" %>
              <% else %>
                <%= image_tag "image_placeholder.svg", alt: "", class: "common-oshi-image" %>
              <% end %>
              <span><strong><%= oshi.name %></strong><br><%= oshi.oshi_type %>／<%= oshi.affiliation.presence || t("ui.states.affiliation_not_set") %>／<%= status %></span>
            <% end %>
            <% if common_image %>
              <p class="common-image-attribution"><%= t("ui.common_images.attribution_prefix") %><%= common_image.attribution_text %>（<%= common_image.license_name %>）</p>
            <% end %>
          </div>
        <% end %>
      </fieldset>
    <% elsif search_query.present? %>
      <p><%= t("ui.oshi.no_results") %></p>
    <% else %>
      <p><%= t("ui.oshi.search_help") %></p>
    <% end %>
    </div>
    <div data-oshi-registration-target="existingFields" <%= "hidden" if @oshis.empty? %>>
      <div data-activity-panel-period>
        <%= render "user_oshis/started_period", f: f, help_id: "existing-period-help" %>
      </div>
      <% unless inline %>
        <p><%= t("ui.oshi.initial_images_help") %></p>
        <%= render "user_oshis/image_upload", f: f, label: t("ui.labels.upload_images"), help_id: "existing-image-help" %>
      <% end %>
      <%= f.submit t("ui.actions.add_selected_oshi"), class: "button" %>
    </div>
  <% end %>
</section>
<section id="oshi-registration" class="card oshi-form" aria-labelledby="oshi-registration-heading" data-oshi-registration-target="registrationPanel">
  <h2 id="oshi-registration-heading"><%= t("ui.oshi.new_heading") %></h2>
  <p><%= link_to t("ui.oshi.back_to_search"), "#oshi-existing", data: { action: "click->oshi-registration#returnToSearch" } %></p>
  <%= render "shared/validation_errors", resource: @oshi %>
  <%= render "shared/validation_errors", resource: @user_oshi %>
  <%= form_with model: @oshi, html: { multipart: true }, data: (inline ? { action: "submit->activity-oshi-panel#submitRegistration", turbo: false } : {}) do |f| %>
    <% if inline %>
      <%= hidden_field_tag :activity_panel, "1" %>
      <%= hidden_field_tag :activity_context_token, context_token, id: "new_activity_context_token" %>
      <p><%= t("ui.activity_panel.pending_help") %></p>
    <% end %>
    <%= hidden_field_tag :continue, ApplicationController::FIRST_ACTIVITY_CONTINUATION, id: "new_continue" if first_activity_continuation? %>
    <fieldset>
      <legend><%= t("ui.oshi.common_heading") %></legend>
      <div class="form-field">
        <%= f.label :name, t("ui.oshi.name_label") %>
        <%= f.text_field :name, placeholder: t("ui.placeholders.oshi_name"), required: true, maxlength: 255, data: { oshi_registration_target: "name", action: "input->oshi-registration#nameChanged" }, aria: { invalid: @oshi.errors[:name].any? } %>
      </div>
      <div class="form-field">
        <%= f.label :oshi_type, t("ui.oshi.type_label") %>
        <%= f.select :oshi_type, Oshi::OSHI_TYPES, { include_blank: t("ui.states.select_prompt") }, required: true, aria: { invalid: @oshi.errors[:oshi_type].any? } %>
      </div>
      <div class="form-field">
        <%= f.label :affiliation, t("ui.labels.affiliation") %>
        <%= f.text_field :affiliation, placeholder: t("ui.placeholders.affiliation"), maxlength: 255, aria: { invalid: @oshi.errors[:affiliation].any? } %>
      </div>
    </fieldset>
    <fieldset>
      <legend><%= t("ui.oshi.personal_heading") %></legend>
      <%= fields_for :user_oshi, @user_oshi, namespace: :new do |uf| %>
        <% unless inline %>
          <p><%= t("ui.oshi.initial_images_help") %></p>
          <%= render "user_oshis/image_upload", f: uf, label: t("ui.labels.upload_images"), help_id: "new-image-help" %>
        <% end %>
        <%= render "user_oshis/started_period", f: uf, help_id: "new-period-help" %>
      <% end %>
    </fieldset>
    <%= f.submit t("ui.oshi.new_heading"), class: "button" %>
  <% end %>
</section>
<% unless inline %>
  <p><%= link_to t("ui.actions.back_to_oshis"), oshis_path %></p>
<% end %>
</div>
