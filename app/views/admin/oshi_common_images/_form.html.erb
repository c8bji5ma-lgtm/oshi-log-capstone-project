<%= render "shared/validation_errors", resource: common_image %>
<%= form_with model: [ :admin, common_image ], html: { multipart: true } do |f| %>
  <%= f.hidden_field :lock_version if common_image.persisted? %>
  <%= f.hidden_field :oshi_id, value: oshi.id if common_image.new_record? %>
  <% if common_image.new_record? %>
    <div class="form-field">
      <%= f.label :image, t("ui.common_images.file_label") %>
      <%= f.file_field :image, required: true, accept: ImageAttachmentInspector::CONTENT_TYPES.join(",") %>
    </div>
  <% else %>
    <%= image_tag common_oshi_image_path(common_image.image.attachment), alt: t("ui.common_images.image_alt", name: oshi.name), class: "common-oshi-image" if common_image.active? %>
  <% end %>
  <div class="form-field"><%= f.label :source_url, t("ui.common_images.source_label") %><%= f.url_field :source_url, placeholder: t("ui.placeholders.source_url"), required: true, maxlength: 2048 %></div>
  <div class="form-field"><%= f.label :creator_name, t("ui.common_images.creator_label") %><%= f.text_field :creator_name, placeholder: t("ui.placeholders.creator"), required: true, maxlength: 255 %></div>
  <div class="form-field"><%= f.label :license_name, t("ui.common_images.license_label") %><%= f.text_field :license_name, placeholder: t("ui.placeholders.license"), required: true, maxlength: 255 %></div>
  <div class="form-field"><%= f.label :attribution_text, t("ui.common_images.attribution_label") %><%= f.text_area :attribution_text, placeholder: t("ui.placeholders.attribution"), required: true %></div>
  <div class="form-field"><%= f.label :usage_notes, t("ui.common_images.usage_notes_label") %><%= f.text_area :usage_notes, placeholder: t("ui.placeholders.usage_notes") %></div>
  <div class="form-field"><%= f.label :rights_confirmed_at, t("ui.common_images.confirmed_at_label") %><%= f.datetime_local_field :rights_confirmed_at, required: true %></div>
  <% unless common_image.new_record? %>
    <div class="form-field"><%= f.label :active do %><%= f.check_box :active %> <%= t("ui.states.enable") %><% end %></div>
  <% end %>
  <%= f.submit common_image.new_record? ? t("ui.common_images.create") : t("ui.common_images.update"), class: "button" %>
<% end %>
