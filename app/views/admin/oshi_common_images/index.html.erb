<% content_for :title, t("ui.common_images.page_title") %>
<h1><%= t("ui.common_images.title") %></h1>
<p><%= t("ui.common_images.rights_help") %></p>
<%= form_with url: admin_oshi_common_images_path, method: :get do |f| %>
  <div class="form-field">
    <%= f.label :q, t("ui.labels.search_oshi") %>
    <%= f.search_field :q, value: @query, required: true, placeholder: t("ui.placeholders.oshi_search") %>
  </div>
  <%= f.submit t("ui.actions.search"), class: "button" %>
<% end %>
<% @oshis.each do |oshi| %>
  <section class="card common-image-admin-card">
    <h2><%= oshi.name %></h2>
    <p><%= oshi.oshi_type %>／<%= oshi.affiliation.presence || t("ui.states.affiliation_not_set") %></p>
    <p><%= t("ui.common_images.count_prefix") %><%= oshi.oshi_common_images.size %>/<%= OshiCommonImage::LIMIT_PER_OSHI %>枚</p>
    <% if oshi.oshi_common_images.size < OshiCommonImage::LIMIT_PER_OSHI %>
      <%= link_to t("ui.common_images.add"), new_admin_oshi_common_image_path(oshi_id: oshi.id), class: "button" %>
    <% end %>
    <div class="common-image-admin-list">
      <% oshi.oshi_common_images.sort_by(&:id).each do |image| %>
        <section class="card">
          <%= image_tag common_oshi_image_path(image.image.attachment), alt: t("ui.common_images.image_alt", name: oshi.name), class: "common-oshi-image", loading: "lazy" if image.active? %>
          <p><%= t("ui.common_images.status_prefix") %><%= image.active? ? t("ui.states.active") : t("ui.states.inactive") %></p>
          <p><%= t("ui.common_images.creator_prefix") %><%= image.creator_name %></p>
          <p><%= t("ui.common_images.license_prefix") %><%= image.license_name %></p>
          <div class="actions">
            <%= link_to t("ui.actions.edit"), edit_admin_oshi_common_image_path(image) %>
            <%= button_to t("ui.actions.delete"), admin_oshi_common_image_path(image), method: :delete,
              params: { oshi_common_image: { lock_version: image.lock_version } }, class: "button button-secondary",
              form: { data: { turbo_confirm: t("ui.common_images.delete_confirm") } } %>
          </div>
        </section>
      <% end %>
    </div>
  </section>
<% end %>
<p><%= link_to t("ui.merge.back"), admin_oshis_path %></p>
