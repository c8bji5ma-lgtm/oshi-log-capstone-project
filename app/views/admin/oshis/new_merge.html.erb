<% content_for :title, t("ui.merge.page_title") %>
<h1><%= t("ui.merge.title") %></h1>
<p id="merge-warning" class="validation-errors"><%= t("ui.merge.warning") %></p>
<% if !@enough_oshis_to_merge %>
  <p><%= t("ui.merge.not_enough") %></p>
<% else %>
  <% statuses = { "pending" => t("ui.states.pending"), "approved" => t("ui.states.approved"), "rejected" => t("ui.states.rejected") } %>
  <% candidate_label = ->(oshi) do
    [ t("ui.merge.candidate", id: oshi.id, name: oshi.name, type: oshi.oshi_type, affiliation: oshi.affiliation.presence || t("ui.states.not_set"), status: statuses.fetch(oshi.status, oshi.status)), oshi.id ]
  end %>
  <%= form_with url: new_merge_admin_oshis_path, scope: :oshi_merge, method: :get do |f| %>
    <div class="form-field">
      <%= f.label :source_query, t("ui.merge.source_query") %>
      <%= f.search_field :source_query, value: @source_query, placeholder: t("ui.placeholders.oshi_search") %>
      <% if @source_has_more %>
        <p role="status"><%= t("ui.merge.source_limit") %></p>
      <% end %>
      <%= f.label :source_id, t("ui.merge.source") %>
      <%= f.select :source_id, options_for_select(@source_candidates.map(&candidate_label), @selected_source&.id), { include_blank: t("ui.merge.select_source") }, aria: { describedby: "merge-warning" } %>
    </div>
    <div class="form-field">
      <%= f.label :target_query, t("ui.merge.target_query") %>
      <%= f.search_field :target_query, value: @target_query, placeholder: t("ui.placeholders.oshi_search") %>
      <% if @target_has_more %>
        <p role="status"><%= t("ui.merge.target_limit") %></p>
      <% end %>
      <%= f.label :target_id, t("ui.merge.target") %>
      <%= f.select :target_id, options_for_select(@target_candidates.map(&candidate_label), @selected_target&.id), { include_blank: t("ui.merge.select_target") }, aria: { describedby: "merge-warning" } %>
    </div>
    <%= f.submit t("ui.merge.search"), class: "button button-secondary" %>
  <% end %>
  <% if @selected_source && @selected_target %>
    <section class="card" aria-labelledby="merge-selection-heading">
      <h2 id="merge-selection-heading"><%= t("ui.merge.selection") %></h2>
      <p><%= t("ui.merge.source_prefix") %><%= candidate_label.call(@selected_source).first %></p>
      <p><%= t("ui.merge.target_prefix") %><%= candidate_label.call(@selected_target).first %></p>
    </section>
    <%= form_with url: merge_admin_oshis_path, scope: :oshi_merge, method: :post, data: { turbo_confirm: t("ui.merge.confirm") } do |f| %>
      <%= f.hidden_field :source_query, value: @source_query %>
      <%= f.hidden_field :target_query, value: @target_query %>
      <%= f.hidden_field :source_id, value: @selected_source.id %>
      <%= f.hidden_field :target_id, value: @selected_target.id %>
      <%= f.submit t("ui.merge.submit"), class: "button" %>
    <% end %>
  <% end %>
<% end %>
<p><%= link_to t("ui.merge.back"), admin_oshis_path %></p>
