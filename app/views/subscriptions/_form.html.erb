<%= render "shared/validation_errors", resource: @subscription %>
<% if @latest_subscription %>
  <section class="conflict-summary" aria-labelledby="subscription-conflict-heading">
    <h2 id="subscription-conflict-heading"><%= t("ui.conflict.current") %></h2>
    <p><%= t("ui.conflict.compare_help") %></p>
    <dl>
      <dt><%= t("ui.subscription.name") %></dt><dd><%= @latest_subscription.name %></dd>
      <dt><%= t("ui.labels.amount") %></dt><dd><%= @latest_subscription.amount %>円</dd>
      <dt><%= t("ui.subscription.cycle") %></dt><dd><%= billing_cycle_label(@latest_subscription.billing_cycle) %></dd>
      <dt><%= t("ui.subscription.oshis") %></dt><dd><%= @latest_subscription.oshis.map(&:name).join("、").presence || t("ui.states.unspecified") %></dd>
      <dt><%= t("ui.subscription.started_on") %></dt><dd><%= @latest_subscription.started_on || "—" %></dd>
      <dt><%= t("ui.subscription.ended_on") %></dt><dd><%= @latest_subscription.ended_on || "—" %></dd>
    </dl>
    <p><%= link_to t("ui.actions.reload_edit"), edit_subscription_path(@latest_subscription), class: "button" %></p>
  </section>
<% end %>
<%= form_with model: @subscription do |f| %>
  <% if @subscription.persisted? %>
    <%= f.hidden_field :lock_version, value: @submitted_lock_version || @subscription.lock_version %>
  <% end %>
  <div class="form-field">
    <%= f.label :name, t("ui.subscription.name_label") %>
    <%= f.text_field :name, placeholder: t("ui.placeholders.subscription_name"), required: true, maxlength: 255, aria: { invalid: @subscription.errors[:name].any? } %>
  </div>
  <div class="form-field">
    <%= f.label :amount, t("ui.subscription.amount_label") %>
    <%= f.number_field :amount, required: true, min: 0, step: 1, aria: { invalid: @subscription.errors[:amount].any?, describedby: "subscription-amount-help" } %>
    <p id="subscription-amount-help"><%= t("ui.subscription.amount_help") %></p>
  </div>
  <div class="form-field">
    <%= f.label :billing_cycle, t("ui.subscription.cycle_label") %>
    <%= f.select :billing_cycle, Subscription.billing_cycles.keys.map { |cycle| [billing_cycle_label(cycle), cycle] }, { include_blank: t("ui.states.select_prompt") }, required: true, aria: { invalid: @subscription.errors[:billing_cycle].any? } %>
  </div>
  <fieldset id="subscription_oshi_ids" class="form-field choice-field subscription-oshi-selection"
            aria-describedby="subscription-oshi-help" aria-invalid="<%= @subscription.errors[:base].any? %>"
            data-controller="oshi-selection" data-oshi-selection-labels-value="<%= t("ui.subscription.selection").to_json %>"
            data-action="change->oshi-selection#refresh keydown->oshi-selection#keydown">
    <legend><%= t("ui.subscription.oshis_label") %></legend>
    <p id="subscription-oshi-help"><%= t("ui.subscription.oshi_help") %></p>
    <% selected_oshi_count = @selectable_oshis.count { |oshi| @selected_oshi_ids.include?(oshi.id) } %>
    <p id="subscription-oshi-status" hidden role="status" aria-atomic="true" data-oshi-selection-target="status"><%= selected_oshi_count.zero? ? t("ui.subscription.selection.none") : t("ui.subscription.selection.selected", count: selected_oshi_count) %></p>
    <details data-oshi-selection-target="panel" <%= "open" if @subscription.errors[:base].any? %>>
      <summary data-oshi-selection-target="summary"><%= t("ui.subscription.selection.toggle") %></summary>
      <div class="choice-chips">
        <%= f.collection_check_boxes :oshi_ids, @selectable_oshis, :id, :name, checked: @selected_oshi_ids do |choice| %>
          <%= choice.label(class: "choice-chip") { choice.check_box(data: { oshi_selection_target: "checkbox" }) + tag.span(choice.text) } %>
        <% end %>
      </div>
      <% if @selectable_oshis.empty? %>
        <p><%= t("ui.subscription.selection.empty") %></p>
      <% end %>
    </details>
  </fieldset>
  <div class="form-field">
    <%= f.label :started_on, t("ui.subscription.started_on_label") %>
    <%= f.date_field :started_on, aria: { invalid: @subscription.errors[:started_on].any? } %>
  </div>
  <div class="form-field">
    <%= f.label :ended_on, t("ui.subscription.ended_on_label") %>
    <%= f.date_field :ended_on, aria: { invalid: @subscription.errors[:ended_on].any? } %>
  </div>
  <%= f.submit(@subscription.persisted? ? t("ui.actions.update") : t("ui.actions.register"), class: "button") %>
<% end %>
