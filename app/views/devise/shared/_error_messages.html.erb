<% if resource.errors.any? %>
  <div class="validation-errors" role="alert" data-turbo-temporary>
    <h2><%= t("errors.messages.not_saved", count: resource.errors.count, resource: resource.class.model_name.human) %></h2>
    <ul>
      <% resource.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>
